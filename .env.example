# This project does not auto-load .env in vanilla PHP.
# Use this file only for environments that export these values (Docker/shell/process manager).
APP_ENV=development
APP_BASE_URL=http://localhost:8080
APP_TIMEZONE=UTC

# Optional: public/index.php reads SPRINTASK_ROOT from real server environment.
# Example split deployment value: /home/cpanel-user/private-app
SPRINTASK_ROOT=

MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=Sprintask
